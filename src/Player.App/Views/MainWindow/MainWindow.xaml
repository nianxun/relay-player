<Window x:Class="Player.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Relay Player"
        Width="1240"
        Height="720"
        MinWidth="1160"
        MinHeight="620"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="TitleBarDragArea"
                      Grid.Column="0"
                      Background="Transparent"
                      MouseLeftButtonDown="TitleBarDragArea_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="Relay Player"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton"
                            Content="&#xE921;"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="MinimizeButton_Click"
                            ToolTip="最小化"/>
                    <Button x:Name="MaximizeButton"
                            Content="&#xE922;"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="MaximizeButton_Click"
                            ToolTip="最大化"/>
                    <Button x:Name="CloseButton"
                            Content="&#xE8BB;"
                            Style="{StaticResource CloseTitleBarButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="关闭"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Grid.RowSpan="3"
                Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,2,0,22">
                    <TextBlock Text="Relay Player"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <Button x:Name="ContinueWatchingButton"
                        Grid.Row="1"
                        Content="继续观看"
                        Style="{StaticResource SidebarButtonStyle}"
                        Tag="False"
                        Click="ContinueWatchingButton_Click"/>

                <Grid Grid.Row="2" Margin="0,24,0,0"
                      MinHeight="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text="服务器"
                                   Style="{StaticResource SectionTitleTextStyle}"
                                   DockPanel.Dock="Left"/>
                    </DockPanel>

                    <ListBox x:Name="ServerListBox"
                             Grid.Row="1"
                             Margin="0,0,0,0"
                             Padding="6"
                             Background="{StaticResource PanelBackgroundBrush}"
                             BorderBrush="{StaticResource ControlBorderBrush}"
                             BorderThickness="1"
                             PreviewMouseRightButtonDown="ServerListBox_PreviewMouseRightButtonDown"
                             PreviewMouseLeftButtonDown="ServerListBox_PreviewMouseLeftButtonDown"
                             SelectionChanged="ServerListBox_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ToolTip="单击服务器即可切换并刷新">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="10">
                                    <ScrollViewer Margin="{TemplateBinding Padding}"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,9"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Root"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    MinHeight="54"
                                                    CornerRadius="7">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="编辑"
                                          Click="EditServerMenuItem_Click"/>
                                <MenuItem Header="修改密码"
                                          Click="ChangeServerPasswordMenuItem_Click"/>
                                <Separator/>
                                <MenuItem Header="删除"
                                          Click="DeleteServerMenuItem_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding ServerUrl}"
                                               Margin="0,4,0,0"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="2"
                          Margin="0,12,0,0">
                        <Button x:Name="LoginButton"
                                Content="添加服务器"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="LoginButton_Click"
                                MinWidth="0"/>
                    </Grid>
                </Grid>

                <StackPanel Grid.Row="3">
                    <Separator Margin="0,0,0,12" Background="{StaticResource DividerBrush}"/>
                    <TextBlock Text="播放器"
                               Style="{StaticResource SectionTitleTextStyle}"/>
                    <TextBox x:Name="MpvPathTextBox"
                             TextWrapping="NoWrap"
                             ToolTip="mpv.net 可执行文件路径"/>
                    <Button x:Name="BrowseMpvButton"
                            Content="选择 mpv.net"
                            Margin="0,8,0,0"
                            Click="BrowseMpvButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="1"
                Background="{StaticResource WindowBackgroundBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Grid.Column="0"
                        Content="返回"
                        Click="BackButton_Click"
                        MinWidth="74"
                        Visibility="Collapsed"/>

                <Grid Grid.Column="1"
                      MinWidth="360"
                      MaxWidth="560"
                      Height="40"
                      HorizontalAlignment="Stretch">
                    <Border Background="{StaticResource ControlBackgroundBrush}"
                            BorderBrush="{StaticResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <TextBox x:Name="SearchTextBox"
                                     Grid.Column="1"
                                     Padding="0,2,12,2"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="14"
                                     MinHeight="38"
                                     VerticalContentAlignment="Center"
                                     KeyDown="SearchTextBox_KeyDown"
                                     ToolTip="输入片名、剧集或文件夹后按 Enter 搜索"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2"
                      Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16,22,20">
                <Border x:Name="DetailPanel"
                        Padding="16"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource ControlBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="288"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Column="0"
                                Width="288"
                                Height="162"
                                Background="{StaticResource ControlBackgroundBrush}"
                                BorderBrush="{StaticResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="暂无封面"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Image x:Name="PosterImage"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="LowQuality"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2">
                                <TextBlock x:Name="ListTitleTextBlock"
                                       Text="媒体详情"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="SelectedTitleTextBlock"
                                       Text="未选择媒体"
                                       Margin="0,4,0,0"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"/>

                            <StackPanel Margin="0,6,0,0">
                                <TextBlock x:Name="SelectedMetaTextBlock"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="SelectedSourceTextBlock"
                                           Margin="0,6,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SelectedOverviewTextBlock"
                                           Margin="0,10,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           LineHeight="18"
                                           MaxHeight="60"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                        <WrapPanel Margin="0,10,0,0"
                                   Grid.Row="1"
                                   Grid.ColumnSpan="3"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"
                                   x:Name="EpisodePickerPanel">
                            <ComboBox x:Name="SeasonComboBox"
                                      Width="126"
                                      MaxDropDownHeight="220"
                                      TextSearch.TextPath="SeasonSelectorLabel"
                                      SelectionChanged="SeasonComboBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SeasonSelectorLabel}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <ComboBox x:Name="EpisodeComboBox"
                                      Width="260"
                                      MaxDropDownHeight="260"
                                      Margin="8,0,0,0"
                                      TextSearch.TextPath="EpisodeSelectorLabel"
                                      SelectionChanged="EpisodeComboBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding EpisodeSelectorLabel}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1"
                                                    Padding="6,2"
                                                    Background="{StaticResource AccentSoftBrush}"
                                                    CornerRadius="999"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsPlayed, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="已播放"
                                                           Foreground="{StaticResource PositiveBrush}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button x:Name="TogglePlayedButton"
                                    Style="{StaticResource IconToggleButtonStyle}"
                                    Click="TogglePlayedButton_Click"
                                    ToolTip="标记已播放"
                                    Margin="8,0,0,0"/>

                        </WrapPanel>

                        <WrapPanel Margin="0,10,0,0"
                                   Grid.Row="2"
                                   Grid.ColumnSpan="3"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center">
                            <Button x:Name="PlayButton"
                                    Content="播放"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="PlayButton_Click"
                                    MinWidth="96"
                                    MinHeight="38"
                                    Margin="0,0,8,0"/>

                            <ComboBox x:Name="MediaSourceComboBox"
                                      Width="142"
                                      MaxDropDownHeight="220"
                                      Margin="0,0,8,0"
                                      SelectionChanged="MediaSourceComboBox_SelectionChanged"
                                      TextSearch.TextPath="DisplayName">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <ComboBox x:Name="VideoTrackComboBox"
                                      Width="112"
                                      MaxDropDownHeight="220"
                                      Margin="0,0,8,0"
                                      TextSearch.TextPath="DisplayName">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <ComboBox x:Name="AudioTrackComboBox"
                                      Width="112"
                                      MaxDropDownHeight="220"
                                      Margin="0,0,8,0"
                                      TextSearch.TextPath="DisplayName">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <ComboBox x:Name="SubtitleTrackComboBox"
                                      Width="112"
                                      MaxDropDownHeight="220"
                                      Margin="0,0,8,0"
                                      TextSearch.TextPath="DisplayName">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <CheckBox x:Name="ResumeCheckBox"
                                      Content="续播"
                                      IsChecked="True"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center"/>
                            <CheckBox x:Name="AutoPlayCheckBox"
                                      Content="连播"
                                      IsChecked="True"
                                      VerticalAlignment="Center"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <DockPanel x:Name="ItemsHeaderPanel"
                           Margin="0,0,0,10">
                    <TextBlock x:Name="ItemsHeaderTextBlock"
                               Text="继续观看"
                               DockPanel.Dock="Left"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                </DockPanel>

                <ListView x:Name="ItemsListView"
                          Background="Transparent"
                          MouseDoubleClick="ItemsListView_MouseDoubleClick"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          SelectionChanged="ItemsListView_SelectionChanged">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Width" Value="214"/>
                            <Setter Property="Height" Value="224"/>
                            <Setter Property="Margin" Value="0,0,12,0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Root"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="120"/>
                                    <RowDefinition Height="96"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="{StaticResource ControlBackgroundBrush}"
                                        BorderBrush="{StaticResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding ThumbnailUri}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="LowQuality"
                                               ImageFailed="ThumbnailImage_ImageFailed"
                                               Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <Border>
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00101114" Offset="0"/>
                                                    <GradientStop Color="#99101114" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border Padding="7,3"
                                                Margin="9"
                                                Background="#AA101114"
                                                CornerRadius="999"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Type}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="10"/>
                                        </Border>
                                        <Border Padding="7,3"
                                                Margin="9"
                                                Background="{StaticResource AccentSoftBrush}"
                                                CornerRadius="999"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Visibility="{Binding IsPlayed, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="已播放"
                                                       Foreground="{StaticResource PositiveBrush}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="1" Margin="2,9,2,0">
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Height="40"
                                               LineHeight="19"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding MetaLine}"
                                               Margin="0,6,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                    <ProgressBar Value="{Binding ResumeProgressPercent, Mode=OneWay}"
                                                 Maximum="100"
                                                 Height="3"
                                                 Margin="0,9,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3"
                Grid.Column="1"
                Background="{StaticResource WindowBackgroundBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusTextBlock"
                       Margin="22,0"
                       Text="就绪"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
