<Window x:Class="Player.App.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relay Player - 修改密码"
        Width="420"
        MinWidth="400"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">
    <Border Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="18,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="TitleBarDragArea"
                          Grid.Column="0"
                          Background="Transparent"
                          MouseLeftButtonDown="TitleBarDragArea_MouseLeftButtonDown">
                        <TextBlock Text="修改密码"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                    </Grid>
                    <Button Grid.Column="1"
                            Content="&#xE8BB;"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="关闭"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="修改密码"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock x:Name="AccountTextBlock"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           LineHeight="19"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="新密码"
                           Style="{StaticResource MutedTextStyle}"/>
                <PasswordBox x:Name="NewPasswordBox"
                             Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                <TextBlock Text="确认新密码"
                           Style="{StaticResource MutedTextStyle}"/>
                <PasswordBox x:Name="ConfirmPasswordBox"
                             Margin="0,5,0,0"
                             KeyDown="ConfirmPasswordBox_KeyDown"/>
                </StackPanel>

                <TextBlock x:Name="ValidationTextBlock"
                           Grid.Row="3"
                           Margin="0,4,0,0"
                           MinHeight="40"
                           VerticalAlignment="Top"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"/>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,18,0,0">
                <Button Content="取消"
                        MinWidth="82"
                        IsCancel="True"
                        Click="CancelButton_Click"/>
                <Button x:Name="SubmitButton"
                        Content="修改"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="90"
                        IsDefault="True"
                        Margin="10,0,0,0"
                        Click="SubmitButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
